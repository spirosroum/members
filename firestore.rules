rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =====================================================================
    // GymDesk security rules (per-record architecture)
    //
    // SECURITY MODEL:
    //   * AUTH-READ   — schedule, plans, settings, closedDates, visits,
    //                   classCheckins, members (top-level). All reads
    //                   require any Firebase auth token (anonymous, Google
    //                   member, or admin). Unauthenticated REST API requests
    //                   are denied.
    //   * ADMIN-READ  — payments, notifications, bins, memberRenames,
    //                   gym (legacy), member private fields (email, phone,
    //                   dob, notes). Admin-only read/write.
    //   * WRITE       — admin may write everything. Authenticated kiosk
    //                   (anonymous) may create/update visits, classCheckins,
    //                   notifications; update member sessionsLeft only.
    //                   Member creation/rename/delete is admin-only.
    //
    // MEMBER PRIVATE DATA:
    //   Sensitive PII (phone, dob, notes) lives in a per-member
    //   subcollection: /members/{id}/private/info — admin-only read/write.
    //   Email is kept public to support member Google sign-in resolution.
    //   The top-level member doc contains only public/display fields.
    //
    // DEPLOY: firebase deploy --only firestore:rules
    // =====================================================================

    // The gym administrator account.
    // Custom claims (request.auth.token.admin == true) are the ONLY check
    // (set via Admin SDK or a Cloud Function). The email fallback was removed:
    // it allowed any account whose email matched to act as admin, and it leaked
    // the admin address into the rules file that ships publicly on GitHub.
    // NOTE: In Firestore rules, reading a missing token claim (e.g.
    // request.auth.token.email) throws instead of returning null, which would
    // deny every request. Always guard claim access with `in`.
    function isAdmin() {
      return request.auth != null &&
             'admin' in request.auth.token &&
             request.auth.token.admin == true;
    }

    // Anonymous kiosk / member self-service flows.
    // Requires a Firebase Anonymous Auth token — unauthenticated requests are denied.
    // CAUTION: Always check isAdmin() BEFORE isKiosk() in any rule. isKiosk()
    // matches any request without an email — including admins if their token
    // email field is absent for any reason. Checking admin first guarantees
    // the admin path has priority.
    function isKiosk() {
      return request.auth != null && !('email' in request.auth.token);
    }

    // Kiosk may only adjust the session counter on member docs.
    // The `id` field was removed: allowing kiosks to rewrite it enabled a
    // rename-then-delete chain (rules delete permits a doc whose stored id
    // differs from its docId), letting an anonymous client tamper with
    // arbitrary members.
    function kioskMemberUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sessionsLeft']);
    }

    // Kiosk check-in flows may only touch the timestamps/status of visits
    function kioskVisitUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['exitTime', 'expectedExitTime', 'isUnpaid', 'memberId', 'entryTime', 'classIds']);
    }

    // Kiosk may only rewrite the memberId on class check-ins (ID changes)
    function kioskClassCheckinUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberId']);
    }

    // =====================================================================
    // AUTHENTICATED-READ COLLECTIONS (kiosk/member-portal require these)
    // Any authenticated client (anonymous or admin) may read. Unauthenticated
    // requests are denied — prevents REST API scraping without a token.
    // =====================================================================

    // Legacy single-document store: kept for history; admin-only.
    // The migration copied all data to per-record collections and deleted
    // the legacy doc. Public read was removed — in the unlikely event the
    // doc still exists, it held all sensitive data in one document.
    match /gym/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Settings (portal name, currency, belt visibility, checkin notice)
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Migration state marker
    match /meta/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Class schedules (public kiosk calendar)
    match /schedules/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Academy closed dates
    match /closedDates/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Membership plans (public pricing/plan listing)
    match /plans/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Visits (kiosk "Currently Inside" and leaderboard need read access;
    // no PII beyond memberId, which is already visible on the kiosk)
    match /visits/{docId} {
      allow read: if request.auth != null;
      allow create: if isKiosk();
      allow update: if isAdmin() || (isKiosk() && kioskVisitUpdate());
      allow delete: if isAdmin();
    }

    // Class-level check-in records (leaderboard training counts,
    // class-details modal check-in history)
    match /classCheckins/{docId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (isKiosk() && !exists(/databases/$(database)/documents/classCheckins/$(docId)));
      allow update: if isAdmin() || (isKiosk() && kioskClassCheckinUpdate());
      allow delete: if isAdmin();
    }

    // =====================================================================
    // ADMIN-ONLY READ COLLECTIONS (sensitive data / internal operations)
    // =====================================================================

    // Payment ledger (financial records)
    match /payments/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // System notifications (contains member activity alerts)
    // Admin must be able to create them too: admin flows (member activation,
    // manual registration, debt cleared) call addNotification in the SAME
    // debounced Firestore batch as the payment/member write. With create
    // kiosk-only, the atomic batch was DENIED for admin — the payment/member
    // write silently failed along with the notification, so both never
    // reached Firestore (payment vanished after refresh, notifications never
    // stored).
    match /notifications/{docId} {
      allow read: if isAdmin();
      allow create: if isAdmin() || isKiosk();
      allow update, delete: if isAdmin();
    }

    // Member ID rename ledger (internal sync metadata)
    match /memberRenames/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() || (isKiosk() && request.resource.data.oldId == docId && request.resource.data.newId is string && request.resource.data.newId.size() > 0);
      allow delete: if isAdmin();
    }

    // Recycle bins (deleted records)
    match /planBin/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /scheduleBin/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /notificationBin/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /bin/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // =====================================================================
    // MEMBERS — public fields on top-level doc, private fields in subcollection
    // =====================================================================

    // Top-level member doc: public display fields (name, belt, gender,
    // expirationDate, accountStatus, sessionsLeft, planDays, hideFromLeaderboard)
    match /members/{docId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (isKiosk() && request.resource.data.id == docId && request.resource.data.name is string);
      allow update: if isAdmin() || (isKiosk() && kioskMemberUpdate());
      // Delete is admin-only. The old kiosk condition (resource.data.id != docId)
      // combined with the removed `id` update permission was the rename-then-delete
      // tampering chain — an anonymous client could re-ID a member then delete it.
      allow delete: if isAdmin();
    }

    // Private member subcollection: email, phone, dob, notes
    // Admin-only read/write. Kiosk clients cannot access this subcollection.
    match /members/{docId}/private/{subDoc} {
      allow read, write: if isAdmin();
    }
  }
}
